<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="GestionCommandes.Maui.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GestionCommandes.Maui.Views"
       Shell.FlyoutBehavior="Flyout"
       Title="GestionCommandes">

    <!-- Structure provisoire : un menu latéral avec nos deux pages.
         Elle sera remplacée par des onglets à l'atelier A4. -->
    <ShellContent Title="Clients"
                  ContentTemplate="{DataTemplate views:ClientsPage}"
                  Route="clients" />

    <ShellContent Title="Nouvelle commande"
                  ContentTemplate="{DataTemplate views:CommandePage}"
                  Route="commande" />
</Shell>
